# Display name used in the sidebar and document title
VITE_APP_NAME="React Boilerplate"

# Base URL of the backend API
VITE_API_URL=https://api.example.com/v1

# Show one-click demo account buttons on the sign-in page (local development only)
VITE_SHOW_DEMO_ACCOUNTS=false

# Endpoint that receives Core Web Vitals (LCP, INP, CLS, FCP, TTFB) via navigator.sendBeacon; leave empty to disable
VITE_WEB_VITALS_URL=
