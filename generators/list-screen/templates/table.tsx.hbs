import { {{icon}} } from 'lucide-react';
import { useTranslation } from 'react-i18next';

import { I18N_NAMESPACES } from '@/core/constants/language.constant';
import { PaginatedTable } from '@/shared/components/paginated-table/paginated-table';
import { StatusView } from '@/shared/components/status-view/status-view';
import { QUERY_STATES } from '@/shared/constants/query-state.constant';
import { resolveQueryState } from '@/shared/utils/query-state.util';
import { Button, BUTTON_VARIANTS, TableHead, TableHeader, TableRow } from '@ui';

import type { {{module.pascal}}TableProps } from '../../types/{{module.kebab}}-table.type';
import { {{module.pascal}}TableBody } from './{{module.kebab}}-table-body/{{module.kebab}}-table-body';

export const {{module.pascal}}Table = ({ listQuery, page, onPageChange }: {{module.pascal}}TableProps) => {
  const { t } = useTranslation([I18N_NAMESPACES.{{module.constant}}, I18N_NAMESPACES.COMMON]);

  const queryState = resolveQueryState({
    isLoading: listQuery.isLoading,
    isError: listQuery.isError,
    isEmpty: listQuery.rows.length === 0,
    hasEmptyNode: true,
  });

  if (queryState === QUERY_STATES.ERROR) {
    return (
      <StatusView
        icon={ {{icon}} }
        title={t('common:queryState.errorTitle')}
        description={t('common:queryState.errorDescription')}
      >
        <Button variant={BUTTON_VARIANTS.OUTLINE} onClick={() => void listQuery.refetch()}>
          {t('common:actions.retry')}
        </Button>
      </StatusView>
    );
  }

  return (
    <PaginatedTable
      summary={t('table.totalLabel', { count: listQuery.total })}
      page={page}
      totalPages={listQuery.totalPages}
      onPageChange={onPageChange}
    >
      <TableHeader>
        <TableRow>
{{#each columns}}
          <TableHead>{t('table.columns.{{key}}')}</TableHead>
{{/each}}
        </TableRow>
      </TableHeader>
      <{{module.pascal}}TableBody queryState={queryState} rows={listQuery.rows} />
    </PaginatedTable>
  );
};
