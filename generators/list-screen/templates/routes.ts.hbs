      path: ROUTE_PATHS.{{module.constant}},
      loader: {{module.camel}}Loader,
      lazy: lazyPage(() => import('@/modules/{{module.kebab}}/{{module.kebab}}'), '{{module.pascal}}Page'),
      handle: { breadcrumb: '{{navigationLabelKey}}' } satisfies RouteHandle,
