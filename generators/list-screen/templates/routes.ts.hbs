import { lazyPage } from '../lazy-page';
import { {{module.camel}}Loader } from '../loaders/{{module.kebab}}.loader';

export const {{module.camel}}Routes: RouteObject[] = [
  createGuardedRoute(ROUTE_ACCESS.{{module.constant}}, [
